# ============================================================
# CareerDNA AI – Backend Environment Configuration
# Copy this file to .env and fill in real values
# ============================================================

# ---- Application ----
APP_NAME="CareerDNA AI"
APP_ENV="development"          # development | production
SECRET_KEY="CHANGE_ME_USE_openssl_rand_hex_32"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS ----
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ---- Database (CockroachDB) ----
# Format: postgresql+asyncpg://user:password@host:port/dbname?sslmode=require
DATABASE_URL="postgresql+asyncpg://root@localhost:26257/careerdna?sslmode=disable"
# Set to "true" to use in-memory SQLite demo mode (no CockroachDB needed)
USE_DEMO_DB="true"

# ---- AWS ----
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---- AWS Bedrock ----
BEDROCK_CLAUDE_MODEL_ID="anthropic.claude-3-5-sonnet-20241022-v2:0"
BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"
# Set to "true" to use deterministic mock responses (no AWS needed)
USE_MOCK_AI="true"

# ---- AWS S3 ----
S3_BUCKET_NAME="careerdna-resumes-dev"
S3_PRESIGNED_URL_EXPIRY=3600

# ---- AWS Cognito (optional, only needed if USE_COGNITO_AUTH=true) ----
USE_COGNITO_AUTH="false"
COGNITO_USER_POOL_ID=""
COGNITO_APP_CLIENT_ID=""
COGNITO_REGION="us-east-1"
