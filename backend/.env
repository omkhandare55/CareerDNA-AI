# CareerDNA AI – Environment Configuration
# ============================================================

# ─── App Settings ────────────────────────────────────────────
APP_NAME=CareerDNA AI
APP_ENV=production
SECRET_KEY=careerdna-hackathon-jwt-secret-2026-cockroachdb-aws
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CockroachDB Cloud (REAL) ───────────────────────────────
USE_DEMO_DB=false
DATABASE_URL=postgresql://om:REPLACE_PASSWORD@silk-ninja-32317.j77.aws-us-east-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# ─── AWS Credentials ────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET_KEY

# ─── AWS Bedrock (REAL) ─────────────────────────────────────
USE_MOCK_AI=false
BEDROCK_CLAUDE_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ─── AWS S3 ──────────────────────────────────────────────────
S3_BUCKET_NAME=careerdna-resumes-dev
S3_PRESIGNED_URL_EXPIRY=3600

# ─── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
